# Optional perf syscall/scheduler tracepoints for short profiling captures.
# Not used by the normal build. Merge it into an already configured tree with
#   make ARCH=arm64 CROSS_COMPILE=aarch64-none-linux-gnu- perf-syscalls.config
# A distinct release keeps the original kernel's modules available for rollback.
CONFIG_LOCALVERSION="-perf-syscalls"
CONFIG_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_FUNCTION_GRAPH_TRACER is not set
