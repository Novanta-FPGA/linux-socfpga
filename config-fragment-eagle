# Enable altera pio functionality
CONFIG_GPIO_ALTERA=y
# Enable system id peripheral
CONFIG_ALTERA_SYSID=y
# Enable Altera mSGDMA driver
CONFIG_ALTERA_MSGDMA=y
CONFIG_UIO=y
CONFIG_UIO_PDRV_GENIRQ=y
# TSN phy support
CONFIG_ADIN_PHY=y
CONFIG_ADIN1100_PHY=y
# USB Network drivers
# USB_USBNET is =m (not =y): this lets us reload the usbnet core itself
# (usbnet.ko) via rmmod/modprobe during development without a full
# kernel image rebuild + reboot cycle. Since a tristate symbol can't be
# =y when something it depends on is =m, USB_NET_CDC_EEM must also drop
# to =m here (it would otherwise get silently capped to =m by
# "make oldconfig" anyway).
CONFIG_USB_USBNET=m
# ax88179_178a disabled: on our actual hardware the AX88179-branded dongle
# enumerates as a standard CDC-NCM class device and binds to cdc_ncm.c
# anyway (confirmed via "lsusb -t" showing Driver=cdc_ncm for it), so the
# vendor driver never gets a chance to claim it. CDC_MBIM must stay =m
# (not =y): it depends on CDC_NCM, and a built-in driver cannot depend
# on a loadable module, so leaving CDC_MBIM=y silently forces CDC_NCM
# back to =y via "make oldconfig" (this happened once already).
# CONFIG_USB_NET_AX88179_178A is not set
CONFIG_USB_NET_CDC_EEM=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_CDC_MBIM=m
# Realtek RTL8152/8153/8156 vendor driver: NOT used. Switching the RTL8156
# 2.5G USB adapter from the generic cdc_ncm driver to this dedicated r8152
# driver caused a severe TX throughput regression (~60k pkts/s down to
# ~40-52k pkts/s) due to r8152's small/fixed USB TX aggregation buffer pool
# and its tasklet-deferred (softirq) TX submission path, which stalls under
# CPU contention with the streaming app. Increasing RTL8152_MAX_TX/agg_buf_sz
# in r8152.c only partially recovered throughput, still short of cdc_ncm.
# Staying on cdc_ncm (CONFIG_USB_NET_CDC_NCM above) instead.
CONFIG_USB_RTL8152=n
# Enable NTFS and FAT file support
CONFIG_FAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_EXFAT_FS=y
CONFIG_EXT4_FS=y
# Allow /dev/mem access to normal RAM (needed for cached DMA buffer mmap
# when reserved-memory nodes have no-map removed from the DTS).
# CONFIG_STRICT_DEVMEM is not set
# AF_XDP zero-copy TX/RX sockets (for xdp_tx_bench experiment)
CONFIG_XDP_SOCKETS=y
